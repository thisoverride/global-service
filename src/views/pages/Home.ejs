<section class="home-console" id="dashboard">
  <h1>Console</h1>

  <h2 class="section-title">Sécurité</h2>

  <div class="dashboard-grid dashboard-grid--wide">
    <div class="stat-card">
      <h3>Connexions réussies (7 j)</h3>
      <div class="stat-value stat-value--ok"><%= stats.success %></div>
    </div>
    <div class="stat-card">
      <h3>Tentatives échouées (7 j)</h3>
      <div class="stat-value <%= stats.failed > 0 ? 'stat-value--alert' : '' %>"><%= stats.failed %></div>
    </div>
    <div class="stat-card">
      <h3>Adresses distinctes (7 j)</h3>
      <div class="stat-value"><%= stats.distinctIps %></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Dernière tentative de connexion</h2>
      <a class="btn btn-secondary" href="/modules/logins">Voir l'historique des connexions</a>
    </div>

    <% if (!lastAttempt) { %>
      <div class="empty-state">
        <p>Aucune tentative enregistrée pour l'instant.</p>
        <p class="muted-note">
          Le journal démarre à la mise en service de cette page : les connexions
          antérieures n'y figurent pas.
        </p>
      </div>
    <% } else { %>
      <%# Une seule tentative : des champs etiquetes se lisent mieux qu'un
          tableau a cinq colonnes dont le corps ne compte qu'une ligne. %>
      <div class="card-body">
        <dl class="field-grid">
          <div class="field">
            <dt>Résultat</dt>
            <dd><%- include('partials/attempt/result', { attempt: lastAttempt }) %></dd>
          </div>
          <div class="field">
            <dt>Quand</dt>
            <dd><%= formatDateTime(lastAttempt.createdAt) %></dd>
          </div>
          <div class="field">
            <dt>Identifiant</dt>
            <dd><%= lastAttempt.username || '—' %></dd>
          </div>
          <div class="field">
            <dt>Provenance</dt>
            <dd><%- include('partials/attempt/origin', { attempt: lastAttempt }) %></dd>
          </div>
          <div class="field">
            <dt>Appareil</dt>
            <dd><%- include('partials/attempt/device', { attempt: lastAttempt }) %></dd>
          </div>
        </dl>
      </div>
    <% } %>
  </div>

  <h2 class="section-title">
    Services
    <span class="section-count"><%= moduleCount %> module<%= moduleCount > 1 ? 's' : '' %></span>
  </h2>

  <% if (categories.length === 0) { %>
    <div class="card">
      <div class="card-body">
        <p>Aucun module installé pour l'instant.</p>
      </div>
    </div>
  <% } else { %>
    <% categories.forEach(group => { %>
      <h3 class="category-title"><%= group.category %></h3>
      <div class="tiles-grid">
        <% group.items.forEach(item => { %>
          <a href="<%= item.url %>" class="service-tile">
            <div class="service-tile-icon"><%- item.icon %></div>
            <div class="service-tile-info">
              <span class="service-tile-name"><%= item.name %></span>
              <span class="service-tile-description"><%= item.description %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</section>
