<section class="home-console" id="dashboard">
  <h1>Console</h1>
  <div class="dashboard-grid">
    <div class="stat-card">
      <h3>Modules installés</h3>
      <div class="stat-value"><%= moduleCount %></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Services</h2>
    </div>
    <div class="card-body">
      <% if (menuServices.services.length === 0) { %>
        <p>Aucun module installé pour l'instant. Utilisez le menu « Services » en haut à gauche une fois qu'un module aura été ajouté.</p>
      <% } else { %>
        <p>Utilisez le menu « Services » en haut à gauche pour ouvrir un module.</p>
      <% } %>
    </div>
  </div>
</section>
