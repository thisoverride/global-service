<%
  function when(iso) {
    return iso ? new Date(iso).toLocaleString('fr-FR') : '—';
  }
%>
<section class="home-console" id="dashboard">
  <h1>Console</h1>

  <div class="dashboard-grid dashboard-grid--wide">
    <div class="stat-card">
      <h3>Modules installés</h3>
      <div class="stat-value"><%= moduleCount %></div>
    </div>
    <div class="stat-card">
      <h3>Connexions réussies (7 j)</h3>
      <div class="stat-value stat-value--ok"><%= stats.success %></div>
    </div>
    <div class="stat-card">
      <h3>Tentatives échouées (7 j)</h3>
      <div class="stat-value <%= stats.failed > 0 ? 'stat-value--alert' : '' %>"><%= stats.failed %></div>
    </div>
    <div class="stat-card">
      <h3>Adresses distinctes (7 j)</h3>
      <div class="stat-value"><%= stats.distinctIps %></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Dernière tentative de connexion</h2>
      <a class="btn btn-secondary" href="/modules/logins">Voir l'historique des connexions</a>
    </div>

    <% if (!lastAttempt) { %>
      <div class="empty-state">
        <p>Aucune tentative enregistrée pour l'instant.</p>
        <p class="muted-note">
          Le journal démarre à la mise en service de cette page : les connexions
          antérieures n'y figurent pas.
        </p>
      </div>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Quand</th>
              <th>Résultat</th>
              <th>Identifiant</th>
              <th>Provenance</th>
              <th>Appareil</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= when(lastAttempt.createdAt) %></td>
              <td>
                <% if (lastAttempt.success) { %>
                  <span class="badge badge-success">Réussie</span>
                <% } else { %>
                  <span class="badge badge-danger">Échouée</span>
                <% } %>
              </td>
              <td class="cell-break"><%= lastAttempt.username || '—' %></td>
              <td class="cell-break">
                <span class="origin-ip"><%= lastAttempt.ip || '—' %></span>
                <% if (lastAttempt.countryName) { %>
                  <span class="origin-country"><%= lastAttempt.countryName %></span>
                <% } %>
                <% if (lastAttempt.spoofSuspect) { %>
                  <span class="badge badge-danger" title="Adresse annoncée différente du pair réel (<%= lastAttempt.peerIp %>), sans passage par Cloudflare : en-tête possiblement forgée.">
                    à vérifier
                  </span>
                <% } %>
              </td>
              <td>
                <span class="device-main"><%= lastAttempt.device.browser %> · <%= lastAttempt.device.os %></span>
                <span class="device-kind"><%= lastAttempt.device.kind %></span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (categories.length === 0) { %>
    <div class="card">
      <div class="card-body">
        <p>Aucun module installé pour l'instant.</p>
      </div>
    </div>
  <% } else { %>
    <% categories.forEach(group => { %>
      <h2 class="category-title"><%= group.category %></h2>
      <div class="tiles-grid">
        <% group.items.forEach(item => { %>
          <a href="<%= item.url %>" class="service-tile">
            <div class="service-tile-icon"><%- item.icon %></div>
            <div class="service-tile-info">
              <span class="service-tile-name"><%= item.name %></span>
              <span class="service-tile-description"><%= item.description %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</section>
