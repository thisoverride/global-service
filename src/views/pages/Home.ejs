<%
  // Etat global tire des seules donnees dont dispose le tableau de bord.
  const alert = stats.failed > 0;
  const health = alert
    ? ['warning', `${stats.failed} tentative${stats.failed > 1 ? 's' : ''} de connexion en échec`]
    : ['ok', 'Aucune tentative de connexion en échec'];
%>
<div class="console-head">
  <div class="console-head-main">
    <span class="console-head-eyebrow">Serveur</span>
    <h1>dalency-core</h1>
    <p class="console-head-sub">
      <%= moduleCount %> module<%= moduleCount > 1 ? 's' : '' %> actif<%= moduleCount > 1 ? 's' : '' %>
      · <%= categories.length %> catégorie<%= categories.length > 1 ? 's' : '' %>
    </p>
  </div>
  <div class="status-pill status-pill--<%= health[0] %>">
    <span class="status-dot"></span><%= health[1] %>
  </div>
</div>

<section class="panel">
  <div class="panel-head">
    <h2>Sécurité <span class="panel-sub">7 derniers jours</span></h2>
    <a class="btn btn-secondary" href="/modules/logins">Voir l'historique des connexions</a>
  </div>

  <div class="metric-row">
    <div class="metric">
      <span class="metric-label">Connexions réussies</span>
      <span class="metric-value metric-value--ok"><%= stats.success %></span>
    </div>
    <div class="metric">
      <span class="metric-label">Tentatives échouées</span>
      <span class="metric-value <%= alert ? 'metric-value--alert' : '' %>"><%= stats.failed %></span>
    </div>
    <div class="metric">
      <span class="metric-label">Adresses distinctes</span>
      <span class="metric-value"><%= stats.distinctIps %></span>
    </div>
    <div class="metric">
      <span class="metric-label">Dernier échec</span>
      <span class="metric-value metric-value--text"><%= formatDateTime(stats.lastFailureAt) %></span>
    </div>
  </div>

  <% if (!lastAttempt) { %>
    <div class="panel-note">
      Aucune tentative enregistrée pour l'instant. Le journal démarre à la mise
      en service de cette page : les connexions antérieures n'y figurent pas.
    </div>
  <% } else { %>
    <div class="panel-strip">
      <span class="panel-strip-label">Dernière tentative</span>
      <dl class="kv-row">
        <div class="kv">
          <dt>Résultat</dt>
          <dd><%- include('partials/attempt/result', { attempt: lastAttempt }) %></dd>
        </div>
        <div class="kv">
          <dt>Quand</dt>
          <dd><%= formatDateTime(lastAttempt.createdAt) %></dd>
        </div>
        <div class="kv">
          <dt>Identifiant</dt>
          <dd><%= lastAttempt.username || '—' %></dd>
        </div>
        <div class="kv">
          <dt>Provenance</dt>
          <dd><%- include('partials/attempt/origin', { attempt: lastAttempt }) %></dd>
        </div>
        <div class="kv">
          <dt>Appareil</dt>
          <dd><%- include('partials/attempt/device', { attempt: lastAttempt }) %></dd>
        </div>
      </dl>
    </div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Services <span class="panel-sub"><%= moduleCount %> module<%= moduleCount > 1 ? 's' : '' %></span></h2>
  </div>

  <% if (categories.length === 0) { %>
    <div class="panel-note">Aucun module installé pour l'instant.</div>
  <% } else { %>
    <%# Colonnes denses facon "Tous les services" d'AWS : on voit tout le
        catalogue sans defiler, au lieu de grandes tuiles tres espacees. %>
    <div class="service-columns">
      <% categories.forEach(group => { %>
        <div class="service-group">
          <h3 class="service-group-title"><%= group.category %></h3>
          <ul class="service-list">
            <% group.items.forEach(item => { %>
              <li>
                <a href="<%= item.url %>" class="service-link">
                  <span class="service-link-icon"><%- item.icon %></span>
                  <span class="service-link-text">
                    <span class="service-link-name"><%= item.name %></span>
                    <span class="service-link-desc"><%= item.description %></span>
                  </span>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
