<section>
  <h1>Modifier la redirection</h1>
  <a href="/modules/bbox" class="btn btn-secondary" style="margin-bottom: 1rem;">← Retour à la Bbox</a>

  <div class="card">
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <form method="POST" action="/modules/bbox/nat/<%= rule.id %>/edit">
        <div class="form-group">
          <label for="description">Description</label>
          <input type="text" id="description" name="description" class="form-control" required
                 value="<%= rule.description %>">
        </div>
        <div class="form-group">
          <label for="protocol">Protocole</label>
          <select id="protocol" name="protocol" class="form-select" required>
            <option value="tcp" <%= rule.protocol === 'tcp' ? 'selected' : '' %>>TCP</option>
            <option value="udp" <%= rule.protocol === 'udp' ? 'selected' : '' %>>UDP</option>
          </select>
        </div>
        <div class="form-group">
          <label for="externalPort">Port externe (vu depuis internet)</label>
          <input type="number" id="externalPort" name="externalPort" class="form-control" min="1" max="65535"
                 required value="<%= rule.externalPort %>">
        </div>
        <div class="form-group">
          <label for="internalIp">Machine de destination (IP locale)</label>
          <input type="text" id="internalIp" name="internalIp" class="form-control" required
                 pattern="(\d{1,3}\.){3}\d{1,3}" value="<%= rule.internalIp %>">
        </div>
        <div class="form-group">
          <label for="internalPort">Port sur cette machine</label>
          <input type="number" id="internalPort" name="internalPort" class="form-control" min="1" max="65535"
                 required value="<%= rule.internalPort %>">
        </div>
        <p class="muted-note">
          Modifier le port externe change ce qui est joignable depuis internet.
          Si ce service est celui qui vous sert à accéder à distance, vérifiez deux fois.
        </p>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="/modules/bbox" class="btn btn-secondary">Annuler</a>
      </form>
    </div>
  </div>
</section>
