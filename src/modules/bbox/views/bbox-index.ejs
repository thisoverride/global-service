<%
  function uptime(seconds) {
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    return d > 0 ? `${d} j ${h} h` : `${h} h`;
  }
%>
<section>
  <h1>Bbox</h1>

  <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="dashboard-grid dashboard-grid--wide">
    <div class="stat-card">
      <h3>IP publique</h3>
      <div class="stat-value stat-value--text"><%= wan.publicIp %></div>
    </div>
    <div class="stat-card">
      <h3>Modèle</h3>
      <div class="stat-value stat-value--text"><%= device.modelName %></div>
    </div>
    <div class="stat-card">
      <h3>Firmware</h3>
      <div class="stat-value stat-value--text"><%= device.firmware %></div>
    </div>
    <div class="stat-card">
      <h3>Allumée depuis</h3>
      <div class="stat-value stat-value--text"><%= uptime(device.uptimeSeconds) %></div>
    </div>
  </div>

  <div class="tiles-grid">
    <a href="/modules/bbox/hosts" class="service-tile">
      <div class="service-tile-icon"><i class="fas fa-laptop" aria-hidden="true"></i></div>
      <div class="service-tile-info">
        <span class="service-tile-name">Appareils connectés</span>
        <span class="service-tile-description">
          <%= hostCount === null ? 'Mot de passe requis' : hostCount + ' appareil(s) en ligne' %>
        </span>
      </div>
    </a>
    <a href="/modules/bbox/nat" class="service-tile">
      <div class="service-tile-icon"><i class="fas fa-right-left" aria-hidden="true"></i></div>
      <div class="service-tile-info">
        <span class="service-tile-name">Redirections de ports</span>
        <span class="service-tile-description"><%= ruleCount %> règle(s) configurée(s)</span>
      </div>
    </a>
  </div>
</section>
