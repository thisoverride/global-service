<section>
  <h1>Bibliothèques Plex</h1>
  <% if (loadError) { %>
    <div class="card"><div class="empty-state">
      <p><%= loadError %></p>
      <a href="/modules/plex/settings" class="btn btn-primary">Configurer le jeton</a>
    </div></div>
  <% } else if (libraries.length === 0) { %>
    <div class="card"><div class="empty-state"><p>Aucune bibliothèque.</p></div></div>
  <% } else { %>
    <div class="card">
      <div class="card-header"><h2><%= libraries.length %> bibliothèque<%= libraries.length > 1 ? 's' : '' %></h2></div>
      <div class="table-container">
        <table>
          <thead><tr><th>Nom</th><th>Type</th><th>Dernière analyse</th></tr></thead>
          <tbody>
            <% libraries.forEach(l => { %>
              <tr>
                <td><%= l.title %></td>
                <td><%= l.type %></td>
                <td><%= l.updatedAt ? new Date(l.updatedAt).toLocaleString('fr-FR') : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>
