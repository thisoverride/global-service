<section>
  <h1>Lectures en cours</h1>
  <% if (loadError) { %>
    <div class="card"><div class="empty-state">
      <p><%= loadError %></p>
      <a href="/modules/plex/settings" class="btn btn-primary">Configurer le jeton</a>
    </div></div>
  <% } else if (sessions.length === 0) { %>
    <div class="card"><div class="empty-state"><p>Aucune lecture en cours.</p></div></div>
  <% } else { %>
    <div class="card">
      <div class="card-header"><h2><%= sessions.length %> lecture<%= sessions.length > 1 ? 's' : '' %></h2></div>
      <div class="table-container">
        <table>
          <thead><tr><th>Titre</th><th>Utilisateur</th><th>Appareil</th><th>État</th><th>Progression</th></tr></thead>
          <tbody>
            <% sessions.forEach(s => { %>
              <tr>
                <td><%= s.title %></td>
                <td><%= s.user %></td>
                <td class="cell-break"><%= s.player %></td>
                <td><span class="badge <%= s.state === 'playing' ? 'badge-success' : '' %>"><%= s.state %></span></td>
                <td><%= s.progress %> %</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>
