<section>
  <h1>Plex</h1>
  <% if (loadError) { %>
    <div class="card"><div class="empty-state"><p><%= loadError %></p></div></div>
  <% } else { %>
    <% if (server.updateAvailable) { %>
      <div class="alert alert-danger">
        Mise à jour disponible : <strong><%= server.latestVersion %></strong>
        (installée : <%= server.version %>)
      </div>
    <% } else if (server.latestVersion) { %>
      <div class="alert alert-success">Plex est à jour.</div>
    <% } %>

    <div class="dashboard-grid dashboard-grid--wide">
      <div class="stat-card">
        <h3>Version installée</h3>
        <div class="stat-value stat-value--text"><%= server.version %></div>
      </div>
      <div class="stat-card">
        <h3>Dernière publiée</h3>
        <div class="stat-value stat-value--text"><%= server.latestVersion || 'indisponible' %></div>
      </div>
      <div class="stat-card">
        <h3>Identifiant serveur</h3>
        <div class="stat-value stat-value--text"><%= server.machineIdentifier.slice(0, 12) %>…</div>
      </div>
    </div>

    <p class="muted-note">
      La mise à jour s'installe avec <code>sudo /opt/scripts/update-plex.sh</code> :
      le dépôt apt de Plex est signé en SHA1, que Debian 13 refuse depuis février 2026,
      d'où l'installation par paquet .deb téléchargé directement.
    </p>
  <% } %>
</section>
