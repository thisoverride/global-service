<%
  const labels = {
    ok:      ['Dernière sauvegarde réussie', 'alert-success'],
    failed:  ['La dernière sauvegarde a ÉCHOUÉ', 'alert-danger'],
    stale:   ['Aucune sauvegarde récente', 'alert-danger'],
    unknown: ['État inconnu', 'alert-danger'],
  };
  const [title, cls] = labels[health];
  function age(h) {
    if (h === null) return '—';
    if (h < 1) return 'il y a moins d\'une heure';
    if (h < 48) return `il y a ${Math.round(h)} h`;
    return `il y a ${Math.round(h / 24)} jours`;
  }
%>
<section>
  <h1>Sauvegardes</h1>

  <div class="alert <%= cls %>">
    <strong><%= title %></strong>
    <% if (status) { %> — <%= age(ageHours) %><% } %>
  </div>

  <% if (problem) { %>
    <div class="card"><div class="card-body"><p class="muted-note"><%= problem %></p></div></div>
  <% } else { %>
    <div class="dashboard-grid dashboard-grid--wide">
      <div class="stat-card">
        <h3>Terminée le</h3>
        <div class="stat-value stat-value--text">
          <%= new Date(status.finishedAt).toLocaleString('fr-FR') %>
        </div>
      </div>
      <div class="stat-card">
        <h3>Taille</h3>
        <div class="stat-value stat-value--text"><%= status.size || '—' %></div>
      </div>
      <div class="stat-card">
        <h3>Code de sortie</h3>
        <div class="stat-value"><%= status.exitCode %></div>
      </div>
    </div>

    <% if (status.failures && status.failures.length > 0) { %>
      <div class="card">
        <div class="card-header"><h2>Raisons de l'échec</h2></div>
        <div class="table-container">
          <table>
            <tbody>
              <% status.failures.forEach(f => { %>
                <tr><td class="cell-break"><%= f %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <div class="card">
      <div class="card-header"><h2>Détails</h2></div>
      <div class="table-container">
        <table>
          <tbody>
            <tr><th>Destination</th><td class="cell-break"><%= status.destination %></td></tr>
            <%
              // Le script consigne un chemin absolu ; on ne propose le lien que
              // si ce fichier fait bien partie de ceux que la console sait lire.
              const logName = String(status.log || '').split('/').pop();
              const readable = logs.some(f => f.name === logName);
            %>
            <tr>
              <th>Journal</th>
              <td class="cell-break">
                <% if (readable) { %>
                  <a href="/modules/backups/logs/<%= encodeURIComponent(logName) %>"><%= status.log %></a>
                <% } else { %>
                  <%= status.log %>
                <% } %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="card">
    <div class="card-header"><h2>Journaux</h2></div>
    <div class="card-body">
      <% if (logs.length === 0) { %>
        <p class="muted-note">Aucun journal lisible depuis la console.</p>
      <% } else { %>
        <p><%= logs.length %> <%= logs.length > 1 ? 'journaux disponibles' : 'journal disponible' %>, du <%= logs[logs.length - 1].date %> au <%= logs[0].date %>.</p>
      <% } %>
      <a class="btn btn-secondary" href="/modules/backups/logs">Consulter les journaux</a>
    </div>
  </div>

  <p class="muted-note">
    La sauvegarde tourne chaque nuit à 03:00 et conserve 7 jours.
    Cette page signale un échec, mais aussi l'absence de sauvegarde récente —
    les 21 et 22 août 2026, le partage réseau n'était pas monté et rien ne l'avait signalé.
  </p>
</section>
