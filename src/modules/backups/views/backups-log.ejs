<%
  // "backup-2026-08-25.log" -> "25 août 2026"
  const day = new Date(log.name.slice(7, -4) + 'T12:00:00')
    .toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
%>
<section>
  <h1>Journal du <%= day %></h1>
  <a href="/modules/backups/logs" class="btn btn-secondary" style="margin-bottom: 1rem;">← Tous les journaux</a>

  <% if (log.truncated) { %>
    <div class="alert alert-danger">
      Journal volumineux : seule la fin du fichier est affichée.
    </div>
  <% } %>

  <div class="card">
    <div class="card-header"><h2><%= log.name %></h2></div>
    <div class="log-toolbar">
      <input type="text" id="log-filter" class="form-control" placeholder="Filtrer les lignes affichées…">
    </div>
    <pre class="log-panel" id="log-panel"><%- log.content
      .split('\n')
      .map(l => `<span class="log-line">${l.replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c])) || '&nbsp;'}</span>`)
      .join('') %></pre>
  </div>
</section>

<script>
  (function () {
    const panel = document.getElementById('log-panel');
    const filterInput = document.getElementById('log-filter');
    filterInput.addEventListener('input', function () {
      const term = filterInput.value.toLowerCase();
      panel.querySelectorAll('.log-line').forEach(function (line) {
        line.style.display = !term || line.textContent.toLowerCase().includes(term) ? '' : 'none';
      });
    });
  })();
</script>
