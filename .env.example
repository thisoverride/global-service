# Base de donnees (utilisateur dedie, pas le superutilisateur)
DATABASE_URL=postgres://console:CHANGEME@postgres-host:5432/console

# Signe les cookies de session (openssl rand -hex 32)
SESSION_SECRET=CHANGEME

# Compte admin cree automatiquement au tout premier demarrage (si la table
# users est vide). Sans effet ensuite, meme si ces valeurs changent.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME

PORT=3000

# Module Eustass (file RabbitMQ)
AMQ_SERVER=amqp://user:pass@rabbitmq-host:5672
ANDDIE_URL=https://anddiecooking.dalency.com

# Module QEMU : DOIT etre le meme chemin des deux cotes du montage Docker
# (voir modules/qemu/pool.ts — libvirtd tourne sur l'hote, pas dans ce
# conteneur, donc les chemins doivent avoir un sens pour lui aussi).
QEMU_POOL_DIR=/opt/app/volumes/console/vm-images
