{
  "name": "console",
  "version": "1.0.0",
  "description": "Console centrale de pilotage des services",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --env-file .env ./src/main.ts",
    "compose": "ts-node-dev ./src/main.ts",
    "prod": "node build/main.js",
    "build": "tsc && cp package.json build/package.json && (cd src && find . \\( -name '*.ejs' -o -name '*.sql' \\) -exec cp --parents {} ../build/ \\;)",
    "test": "jest"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/dockerode": "^4.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dockerode": "^5.0.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^7.1.0",
    "inversify": "^6.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2"
  }
}
